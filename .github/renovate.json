{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>golles/github-workflows//renovate/ha-integration"],
  "packageRules": [
    {
      "description": "Don't pin serialx in manifest.json \u2014 Home Assistant core ships it and rejects mismatched pins",
      "matchFileNames": ["custom_components/**/manifest.json"],
      "matchPackageNames": ["serialx"],
      "enabled": false
    }
  ]
}
